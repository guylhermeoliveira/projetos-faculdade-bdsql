DROP TABLE IF EXISTS premio CASCADE;
CREATE TABLE premio (
sigla_premio CHAR(6) PRIMARY KEY,
nome_premio VARCHAR(30) NOT NULL
);
-- Adicionando nova coluna nacionalidade
ALTER TABLE premio ADD COLUMN nacionalidade VARCHAR (20) NOT NULL;
DROP TABLE IF EXISTS propaganda CASCADE;
CREATE TABLE propaganda (
codigo_propaganda SERIAL PRIMARY KEY,
nome_propaganda VARCHAR(50) NOT NULL,
descricao VARCHAR(100) NOT NULL,
agencia VARCHAR(25) NOT NULL,
produto_anunciado VARCHAR(30) NOT NULL,
classificacao_etaria VARCHAR(15) NOT NULL,
duracao_min SMALLINT NOT NULL
);
-- Adicionando constraint check para classificação etária
ALTER TABLE propaganda ADD CONSTRAINT chk_classificacao CHECK (classificacao_etaria IN ('Livre', '10', '14', '18'));
DROP TABLE IF EXISTS premiacao_filme CASCADE;
CREATE TABLE premiacao_filme (
sigla_premio CHAR(6) NOT NULL,
codigo_filme INTEGER NOT NULL,
categoria_premiacao CHAR(15) NOT NULL,
ano_premiacao SMALLINT NOT NULL
);
ALTER TABLE premiacao_filme ADD CONSTRAINT fk_premio FOREIGN KEY (sigla_premio) REFERENCES premio
ON DELETE CASCADE ON UPDATE CASCADE;
ALTER TABLE premiacao_filme ADD CONSTRAINT fk_codigo_filme FOREIGN KEY (codigo_filme) REFERENCES filme
ON DELETE CASCADE ON UPDATE CASCADE;
ALTER TABLE premiacao_filme ADD CONSTRAINT pk_premiacao PRIMARY KEY (sigla_premio, codigo_filme, categoria_premiacao
);
DROP TABLE IF EXISTS indicacao CASCADE;
CREATE TABLE indicacao (
codigo_filme INTEGER NOT NULL,
sigla_premio CHAR(6) NOT NULL,
categoria_indicacao CHAR(15) NOT NULL,
ano_indicacao SMALLINT NOT NULL
);
ALTER TABLE indicacao ADD CONSTRAINT fk_codigo_filme FOREIGN KEY (codigo_filme) REFERENCES filme
ON DELETE CASCADE ON UPDATE CASCADE;
ALTER TABLE indicacao ADD CONSTRAINT fk_premio FOREIGN KEY (sigla_premio) REFERENCES premio
ON DELETE CASCADE ON UPDATE CASCADE;
ALTER TABLE indicacao ADD CONSTRAINT pk_indicacao PRIMARY KEY (codigo_filme, sigla_premio, categoria_indicacao
);
DROP TABLE IF EXISTS propaganda_exibicao CASCADE;
CREATE TABLE propaganda_exibicao (
num_sessao INTEGER NOT NULL,
codigo_propaganda INTEGER NOT NULL
);
ALTER TABLE propaganda_exibicao ADD CONSTRAINT fk_sessao FOREIGN KEY (num_sessao) REFERENCES sessao_exibicao
ON DELETE CASCADE ON UPDATE CASCADE;
ALTER TABLE propaganda_exibicao ADD CONSTRAINT fk_propaganda FOREIGN KEY (codigo_propaganda) REFERENCES propaganda
ON DELETE CASCADE ON UPDATE CASCADE;
ALTER TABLE propaganda_exibicao ADD CONSTRAINT pk_propaganda_exibicao PRIMARY KEY (num_sessao, codigo_propaganda
