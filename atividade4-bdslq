DROP TABLE IF EXISTS sala CASCADE;
CREATE TABLE sala (
nome_sala CHAR(15) PRIMARY KEY,
tipo_audio VARCHAR(15) NOT NULL,
tipo_projecao VARCHAR(15) NOT NULL,
capacidade SMALLINT NOT NULL,
situacao_sala VARCHAR(15) NOT NULL
);
-- Alterando o tipo de CHAR para VARCHAR
ALTER TABLE sala ALTER COLUMN nome_sala TYPE VARCHAR(15);
DROP TABLE IF EXISTS filme CASCADE;
CREATE TABLE filme (
cod_filme INTEGER,
titulo_original VARCHAR(50) NOT NULL,
titulo_nacional VARCHAR(50) NOT NULL,
idioma_original VARCHAR(20) NOT NULL,
sinopse VARCHAR(500) NULL,
ano_lancamento SMALLINT NOT NULL,
duracao_minutos SMALLINT NOT NULL,
PRIMARY KEY (cod_filme)
);
-- Adicionando constraint check para duração maior que 0
ALTER TABLE filme ADD CONSTRAINT chk_duracao CHECK (duracao_minutos > 0);
-- Renomeando coluna
ALTER TABLE filme RENAME COLUMN sinopse TO sinopse_filme;
