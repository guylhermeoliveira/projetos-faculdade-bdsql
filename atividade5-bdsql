SELECT * FROM funcionario;
-- Função random, gera um número aleatório entre 0 e 1
SELECT RANDOM();
UPDATE funcionario SET dt_nascto_func = current_date - INTERVAL '22' YEAR where cod_funcional = 500;
UPDATE funcionario SET dt_nascto_func = current_date - INTERVAL '25' YEAR where cod_funcional = 501;
UPDATE funcionario SET dt_nascto_func = current_date - INTERVAL '30' YEAR where cod_funcional = 502;
UPDATE funcionario SET dt_nascto_func = current_date - INTERVAL '35' YEAR where cod_funcional = 503;
-- 6) Consultas com LIKE - busca aproximada
-- Mostrar os funcionários com endereço no Ipiranga
SELECT nome_func AS Funcionario, endereco_func AS Endereço
FROM funcionario WHERE endereco_func ILIKE '%ipiranga%';
-- 7) Funcionários que possuem 'João' no nome
SELECT * FROM funcionario WHERE nome_func ILIKE '%jo_o%';
-- Começa com João
SELECT * FROM funcionario WHERE nome_func ILIKE 'jo_o %';
-- Termina com Júnior
SELECT * FROM funcionario WHERE nome_func ILIKE '% j_nior';
-- Filme que tem na sinopse as palavras amor e ódio
SELECT titulo_original, sinopse FROM filme WHERE sinopse NOT ILIKE '% amor %' AND sinopse NOT ILIKE '% _dio %';
-- 8) Funções de data
-- Data do sistema
SELECT current_date AS Data_atual,
current_timestamp AS "Data e hora atual",
now() AS "Similar ao current_timestamp",
localtimestamp AS Data_hora_local;
-- 9) Extraindo partes da data hora EXTRACT
SELECT EXTRACT (YEAR FROM current_date) AS Ano_atual,
EXTRACT(MONTH FROM current_timestamp) AS Mês_atual,
EXTRACT(HOUR FROM now()) + 2 AS Hora_atual_mais_2_horas,
EXTRACT(WEEK FROM current_timestamp) AS Semana_atual;
-- 10) Operador INTERVAL adiciona ou subtrai intervalos de tempo
SELECT current_date + INTERVAL '3' MONTH AS "Daqui três meses",
current_timestamp - INTERVAL '3' HOUR - INTERVAL '20' MINUTE AS "Três horas e 20min atrás";
-- 11) Funcionários admitidos há mais de um ano
SELECT * FROM funcionario WHERE dt_admissao <= current_date - INTERVAL '1' YEAR
ORDER BY dt_admissao DESC;
-- 12) Calculando há quanto tempo está na empresa
SELECT nome_func, dt_admissao AS Admissão, TRUNC(((current_date - dt_admissao)/365.25),2) AS Tempo_Empresa
FROM funcionario WHERE dt_admissao <= current_date - INTERVAL '1' YEAR
ORDER BY Tempo_empresa DESC;
SELECT nome_func, dt_admissao AS Admissão, dt_nascto_func AS Nascimento,
TRUNC(((current_date - dt_admissao)/365.25),2) AS Tempo_Empresa,
TRUNC(((current_date - dt_nascto_func)/365.25),6) AS Idade
FROM funcionario WHERE dt_admissao <= current_date - INTERVAL '1' YEAR
ORDER BY Tempo_empresa DESC;
-- 13) Between - Funcionários entre 18 e 30 anos
SELECT nome_func, dt_nascto_func AS Nascimento,
TRUNC(((current_date - dt_nascto_func)/365.25),2) AS Idade
FROM funcionario WHERE dt_nascto_func BETWEEN current_date - INTERVAL '30' YEAR AND current_date - INTERVAL '18' YEAR
ORDER BY Idade DESC;
-- 14) Consultas envolvendo mais de uma tabela - relacionar as tabelas entre si. Como? Comparando o valor de PK com FK
SELECT sessao.num_sessao, sessao.dt_sessao, filme.titulo_original, filme.duracao_min
FROM filme, sessao WHERE filme.cod_filme = sessao.cod_filme; -- Junção interna
-- Outra forma com alias/apelido
SELECT s.num_sessao, s.dt_sessao, f.titulo_original, f.duracao_min
FROM filme AS f, sessao AS s WHERE f.cod_filme = s.cod_filme; -- Junção interna
-- 15) Idem ao 14 com a sintaxe do INNER JOIN
SELECT s.num_sessao, s.dt_sessao, f.titulo_original, f.duracao_min FROM filme AS f
INNER JOIN sessao AS s ON (f.cod_filme = s.cod_filme) WHERE EXTRACT(MONTH FROM s.dt_sessao) =
EXTRACT(MONTH FROM current_date); -- Colunas de junção PK <> FK

