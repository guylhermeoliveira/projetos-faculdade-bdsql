-- 16 - Programação  deste Mês - Numero da sessão, data da sessao,
-- hora da sessao, filme , duração
-- junção de sessão x horario x filme
-- sintaxe do WHERE
SELECT s.num_sessao AS Sessão, s.dt_sessao AS Data, h.horario AS Hora,
f.titulo_original AS Filme, f.duracao_min AS "Duração minutos"
FROM sessao s, filme f , horario h
