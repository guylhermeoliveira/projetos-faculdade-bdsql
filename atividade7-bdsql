SELECT DISTINCT f1.nome_func AS "Funcionária 1", f2.nome_func AS "Funcionária 2",
et1.dia_semana AS "Dia Semana", h.horario AS Horario
FROM escala_trabalho et1 JOIN escala_trabalho et2 ON et1.cod_horario = et2.cod_horario
AND et1.dia_semana = et2.dia_semana AND et1.cod_funcional <> et2.cod_funcional
JOIN funcionario f1 ON et1.cod_funcional = f1.cod_funcional
JOIN funcionario f2 ON et2.cod_funcional = f2.cod_funcional
JOIN horario h ON et1.cod_horario = h.cod_horario
WHERE f1.sexo_func = 'F' AND f2.sexo_func = 'F'
AND f1.cod_funcional < f2.cod_funcional ORDER BY et1.dia_semana, h.horario;
