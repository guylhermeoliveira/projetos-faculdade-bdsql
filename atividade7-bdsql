-- 12 - Funcionário admitidos há mais de um ano, tempo de empresa
SELECT nome_func, dt_admissao AS Admissão,
dt_nascto_func AS Nascimento,
TRUNC(((current_date - dt_admissao)/365.25),2)  AS Tempo_Empresa,
TRUNC(((current_date - dt_nascto_func)/365.25),6)  AS Idade 
FROM funcionario
WHERE dt_admissao <= current_date - INTERVAL '1' YEAR 
ORDER BY Idade DESC ;
	-- 13 - Between - Funcionários entre 18 e 30 anos
SELECT nome_func, dt_nascto_func AS Nascimento,
TRUNC(((current_date - dt_nascto_func)/365.25),2)  AS Idade 
FROM funcionario
WHERE dt_nascto_func BETWEEN current_date - INTERVAL '30' YEAR
                                                  AND current_date - INTERVAL '18' YEAR 
ORDER BY Idade DESC ; 

/** 14 - consultas envolvendo mais de uma tabela - relacionar
as tabelas entre si. Como ? Comparando valor de PK com FK 
-> operação de JUNÇÃO - JOIN    **/
SELECT sessao.num_sessao , sessao.dt_sessao ,
               filme.titulo_original , filme.duracao_min
FROM filme, sessao 
WHERE filme.cod_filme = sessao.cod_filme  ;  -- Junção interna

-- outra forma com alias/ apelido
SELECT s.num_sessao , s.dt_sessao ,
               f.titulo_original , f.duracao_min
FROM filme AS f , sessao AS s 
WHERE f.cod_filme = s.cod_filme  ;  -- Junção interna

-- 15 - idem ao 14 com a sintaxe do INNER JOIN
SELECT s.num_sessao , s.dt_sessao ,
               f.titulo_original , f.duracao_min
FROM filme  f  INNER JOIN  sessao s 
ON ( f.cod_filme = s.cod_filme)  
WHERE EXTRACT(MONTH FROM s.dt_sessao) =  
              EXTRACT(MONTH FROM current_date ) ;  -- colunas de junção PK<->FK

