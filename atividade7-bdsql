WHEN (s.publico_total::NUMERIC / sa.capacidade::NUMERIC) * 100 < 50 THEN 'INSATISFATÓRIO'
WHEN (s.publico_total::NUMERIC / sa.capacidade::NUMERIC) * 100 BETWEEN 50 AND 80 THEN 'SATISFATÓRIO'
ELSE 'EXCELENTE'
END AS Classificacao 
FROM sessao s JOIN filme f ON s.cod_filme = f.cod_filme
JOIN sala sa ON s.nome_sala = sa.nome_sala
JOIN horario h ON s.cod_horario = h.cod_horario ORDER BY 7 DESC;

--7.e
SELECT sa.nome_sala AS Sala_Campea, ROUND(SUM(s.renda) / SUM(s.publico_total),2) AS Rentabilidade
FROM sala sa JOIN sessao s ON sa.nome_sala = s.nome_sala
WHERE EXTRACT(YEAR FROM s.dt_sessao) = EXTRACT(YEAR FROM current_date)
GROUP BY sa.nome_sala HAVING SUM(s.publico_total) > 0
ORDER BY Rentabilidade DESC LIMIT 1;
-- 7.F
SELECT s.num_sessao AS "Número Sessão",
s.dt_sessao AS Data, h.horario AS Horario,
f.titulo_original AS "Título Filme", s.publico_total AS Publico,
(SELECT ROUND(AVG(publico_total),2) FROM sessao
WHERE EXTRACT(YEAR FROM dt_sessao) = EXTRACT(YEAR FROM current_date)) AS "Média de Público"
FROM sessao s JOIN filme f ON s.cod_filme = f.cod_filme
JOIN horario h ON s.cod_horario = h.cod_horario
WHERE s.publico_total > (SELECT AVG(publico_total) FROM sessao
WHERE EXTRACT(YEAR FROM dt_sessao) = EXTRACT(YEAR FROM current_date))
AND EXTRACT(YEAR FROM s.dt_sessao) = EXTRACT(YEAR FROM current_date)
ORDER BY s.publico_total DESC;

