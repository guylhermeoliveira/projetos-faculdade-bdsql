/*** aula 05/maio - DQL - Data Query Language - Consultas com SELECT - funções caractere, data, LIKE, Junção Interna - INNER JOIN ***/
/** estrutura básica de um SELECT
SELECT coluna1, coluna2, ..., colunaN -- várias colunas
FROM tabela1, tabela2, ..., tabela N -- várias tabelas
WHERE condição1 AND condição2 OR ... condiçãoN ; -- várias condições **/

-- 1 - Select + básico de todos, mostra todas as linhas e colunas
SELECT * FROM filme ;
SELECT * FROM sessao ;
-- 2 - Discriminando as colunas e impondo filtro/condição
-- operadores de compração = < > <= >= // diferente !=  <>
SELECT titulo_original, duracao_min , genero, ano_lancamento
FROM filme
WHERE ano_lancamento <= 2000 ;
-- 3 - idem 2 mas para generos diferentes de drama OU duração superior a 100 min, com a função UPPER de formatação de texto
SELECT titulo_original, duracao_min , genero, ano_lancamento
FROM filme
WHERE ( ano_lancamento <= 2000 AND UPPER(genero) != 'DRAMA' ) 
OR duracao_min > 100 ;
-- 4 - funções de formatação de caractere e apelido para colunas
SELECT UPPER(nome_propag) AS Maiúsculo,
LOWER(descr_propag) AS Minúsculo,
INITCAP(classifica_etaria) AS "Primeira Maiúsculo, resto minúsculo"
FROM propaganda
WHERE duracao_segundos > 15 ;

-- 5 - operador de concatenação || , "gruda" uma palavra na outra 
-- eliminando o espaço entre elas
SELECT UPPER(nome_func||' reside em '||endereco_func||' com fone : '||
CAST(fone_func AS CHAR(15))) AS "Dados principais" 
FROM funcionario
WHERE dt_admissao > DATE('01-01-2000') ;

