-- 18 - Mostrar os funcionários de cada sessão e as propagandas
-- numero da sessao, data, horário, nome funcionário, função, dia da semana,
-- titulo propaganda, produto anunciado, classificação etária
-- para as funcionárias do sexo feminino com idade entre 18 e 40 anos
-- e propagandas com classificação etária LIVRE
SELECT s.num_sessao AS Sessão, 
CAST(dt_sessao AS CHAR(10))||'-'||CAST(h.horario AS CHAR(8)) AS Hora_Sessão , f.nome_func AS Funcionário, et.funcao , et.dia_semana,
p.nome_propag AS Propaganda, p.produto_anunciado AS Produto, 
p.classifica_etaria 
FROM sessao s JOIN sessao_propaganda sp -- sessao x sessao_propag
                                     ON ( s.num_sessao = sp.num_sessao)
                           JOIN propaganda p  -- sessao_propag x propaganda
                                     ON ( sp.cod_propaganda = p.cod_propaganda)
                           JOIN horario h  -- sessao x horario
                                     ON ( s.cod_horario = h.cod_horario)
                           JOIN escala_trabalho et -- horario x escala
                                     ON ( h.cod_horario = et.cod_horario)
                           JOIN funcionario f -- escala x funcionario
                                     ON ( et.cod_funcional = f.cod_funcional)
WHERE f.sexo_func = 'F' 
 --      AND f.dt_nascto_func BETWEEN current_date - INTERVAL '40' YEAR
 --                                          AND current_date - INTERVAL '18' YEAR
AND TRUNC(( current_date - f.dt_nascto_func)/365.25, 1)  
BETWEEN 18 AND 40
AND p.classifica_etaria ILIKE '%livre%' ; 

