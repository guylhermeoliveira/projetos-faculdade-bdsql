/* 4 - Mostrar as sessões de cinema exibidas este ano que não tem som do tipo Surround:
Número da Sessão – Data Sessão – Tipo Áudio */
SELECT s.num_sessao, s.dt_sessao, sa.tipo_audio
FROM sessao s , sala sa
WHERE sa.nome_sala = s.nome_sala  -- junção sala x sessão
AND EXTRACT(YEAR FROM s.dt_sessao ) = 
         EXTRACT(YEAR FROM current_date)
AND sa.tipo_audio NOT ILIKE '%surround%' 
ORDER BY s.num_sessao ;
-- sintaxe INNER JOIN 
SELECT s.num_sessao, s.dt_sessao, sa.tipo_audio, sa.nome_sala
FROM sessao s INNER JOIN sala sa
ON (sa.nome_sala = s.nome_sala)
WHERE EXTRACT(YEAR FROM s.dt_sessao ) =
      EXTRACT(YEAR FROM current_date)
AND sa.tipo_audio NOT ILIKE '%surround%' 
ORDER BY 1 ;


