FROM sessao s, filme f, horario h
WHERE s.cod_filme = f.cod_filme -- sessao x filme	
  AND s.cod_horario = h.cod_horario -- sessao x horario
  AND EXTRACT(MONTH FROM s.dt_sessao) =
 	  EXTRACT(MONTH FROM current_date)
