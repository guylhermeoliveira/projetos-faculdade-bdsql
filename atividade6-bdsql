/*** aula 05/maio - DQL (Data Query Language) - Consultas com SELECT - funções caractere, data, LIKE
Junção Interna - INNER JOIN ***/
/*** Estrutura básica de um SELECT
SELECT coluna1, coluna2, ..., colunaN - várias colunas
FROM tabela1, tabela2, ..., tabelaN - várias tabelas
WHERE condicao1 AND condicao2 OR ... condicaoN ; - várias condições ***/

-- 1) Select mais básico de todos, mostrando todas as linhas e colunas
SELECT * FROM Filme;
SELECT * FROM sessao;
-- 2) Discriminando as colunas e impondo filtro/condição
SELECT titulo_original, duracao_min, genero, ano_lancamento FROM filme WHERE ano_lancamento <= 2000;
-- 3) idem 2, mas para generos diferentes de drama ou duração superior a 100 min e utilizando função UPPER de caractere
SELECT titulo_original, duracao_min, genero, ano_lancamento FROM filme WHERE (ano_lancamento <= 2000
AND UPPER(genero) != 'DRAMA') OR duracao_min > 100;
-- 4) Funções de formatação de caractere e apelido para colunas
SELECT UPPER(nome_propag) AS maiusculo,
LOWER(descr_propag) AS minusculo,
INITCAP(classifica_etaria) AS "primeira maiusculo, resto minusculo"
FROM propaganda WHERE duracao_segundos > 15;
-- 5) Operador de concatenação ||, "Gruda" uma palavra na outra, eliminando o espaço entre elas
SELECT UPPER (nome_func||' reside em '||endereco_func||' com fone: '|| CAST(fone_func AS CHAR)) AS "Dados principais"
FROM funcionario WHERE dt_admissao > DATE('01-01-2000');
/*** Incluindo a coluna data de nascimento no funcionário, e atualizando randomicamente ***/
