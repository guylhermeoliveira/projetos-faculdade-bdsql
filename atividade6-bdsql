WHERE f.sinopse NOT ILIKE '%amor%'
AND f.sinopse NOT ILIKE '%paix_o%'
AND f.sinopse NOT ILIKE '%romance%'
AND f.genero ILIKE '%romance%'
AND f.ano_lancamento BETWEEN 2011 AND 2020
AND UPPER(f.idioma_original) NOT LIKE '%INGL_S%' ;

